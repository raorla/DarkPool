# URL RPC Sepolia Testnet
SEPOLIA_PROVIDER_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key

# Clé privée ECDSA utilisée par le déploiement du contrat (Deployer)
DEPLOYER_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Clé privée ECDSA utilisée par l'enclave pour signer les matches sur la blockchain Sepolia
ENCLAVE_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Clé privée ECIES (hex 256-bit) utilisée par l'enclave pour déchiffrer les ordres client
ENCLAVE_DECRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Adresse du smart contract DarkPoolVault déployé sur Sepolia
VAULT_ADDRESS=0x0000000000000000000000000000000000000000

