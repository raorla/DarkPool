{
  "name": "nox-darkpool-mvp",
  "version": "1.0.0",
  "description": "Production-ready MVP of Decentralized Dark Pool on iExec Nox",
  "main": "dist-server/enclave/index.js",
  "scripts": {
    "start": "npm run build && concurrently -n \"enclave,relayer,dev\" -c \"magenta,cyan,blue\" \"npm run enclave\" \"npm run relayer\" \"npm run dev\"",
    "build": "tsc",
    "enclave": "node dist-server/enclave/index.js",
    "client": "node dist-server/client/index.js",
    "relayer": "node dist-server/relayer/index.js",
    "dev": "vite",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "test": "hardhat test",
    "e2e": "node scripts/e2e-sepolia.mjs",
    "e2e:confidential": "node scripts/e2e-confidential-sepolia.mjs"
  },
  "dependencies": {
    "@iexec-nox/handle": "^0.1.0-beta.13",
    "@iexec-nox/nox-protocol-contracts": "^0.2.4",
    "@openzeppelin/contracts": "^5.0.2",
    "dotenv": "^16.4.5",
    "eciesjs": "^0.4.0",
    "ethers": "^6.16.0",
    "viem": "^2.52.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^20.14.2",
    "concurrently": "^10.0.3",
    "hardhat": "^2.28.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^5.2.11"
  }
}
